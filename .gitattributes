# .gitattributes — canonical line-ending policy for Agentic-FinSearch.
#
# This repo lives on a Windows mount under WSL and is built/run in Linux
# containers, so the source of truth is LF. A one-time normalization commit
# rewrote existing CRLF blobs to LF; that commit is listed in
# .git-blame-ignore-revs so `git blame` skips it.
#
# Strategy:
#   `* text=auto` lets Git auto-detect text vs binary (binaries are left
#   untouched) and stores all text as LF in the repository. The named text
#   types below additionally pin `eol=lf` so the *working tree* is LF on every
#   platform, not just inside the repo. Windows-only scripts are pinned CRLF.

# Default: auto-detect; normalize all detected text to LF in the repository.
* text=auto

# --- Source code -----------------------------------------------------------
*.py     text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf

# --- Config / data ---------------------------------------------------------
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.xml    text eol=lf
*.ini    text eol=lf
*.cfg    text eol=lf
*.txt    text eol=lf
*.lock   text eol=lf

# --- Docs ------------------------------------------------------------------
*.md     text eol=lf
*.rst    text eol=lf

# --- Shell / container / build (MUST be LF to run under Linux) -------------
*.sh         text eol=lf
*.bash       text eol=lf
Dockerfile   text eol=lf
*.dockerfile text eol=lf
Procfile     text eol=lf
Makefile     text eol=lf
*.mk         text eol=lf

# --- Windows-only scripts (MUST be CRLF) -----------------------------------
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# --- Binary (never normalize, never line-diff) -----------------------------
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.zip    binary
*.gz     binary
*.whl    binary
