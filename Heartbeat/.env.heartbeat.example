# Agentic FinSearch news heartbeat — configuration template.
# Production copy lives at /home/deploy/fingpt/envs/.env.heartbeat (never commit
# the real file; the token and API key are secrets).

# Summarization (falls back to extractive digest when unset/failing)
OPENAI_API_KEY=
HEARTBEAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Pipeline
HEARTBEAT_DRY_RUN=1
HEARTBEAT_WATCHLIST=AAPL MSFT NVDA GOOGL AMZN META TSLA BRK-B JPM BTC-USD
HEARTBEAT_WINDOW_HOURS=24
HEARTBEAT_HOME=/home/deploy/fingpt/heartbeat

# Discord delivery — see Heartbeat/DISCORD_BOT_SETUP.md. With HEARTBEAT_DRY_RUN=0
# and both values set, the digest is posted to the channel.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
